# Copy to .env and fill in. Used only by `./build.sh --debug`, which bakes these
# values straight into the shortcuts so there are no setup questions to answer
# on every test import.
#
# .env and dist-debug/ are both gitignored. A debug build contains a real
# password, the school-wide secret and your check-in code — never commit one,
# never AirDrop one to anybody else.
# Brightwheel sign-in requires a verification code, so nothing can renew
# this automatically. Capture it and paste it here.
BRIGHTWHEEL_SESSION_TOKEN=
# Only used to sign in again when the token expires. Sign-in needs a
# 6-digit code, which the shortcut prompts for.
BRIGHTWHEEL_EMAIL=
BRIGHTWHEEL_PASSWORD=
BRIGHTWHEEL_CHECKIN_CODE=
BRIGHTWHEEL_SCHOOL_SECRET=
BRIGHTWHEEL_START_HOUR=8
BRIGHTWHEEL_END_HOUR=18

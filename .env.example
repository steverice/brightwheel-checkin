# Copy to .env and fill in. Used only by `./build.sh --debug`, which bakes these
# values straight into the shortcuts so there are no setup questions to answer
# on every test import.
#
# A debug build contains these values in plaintext. Do not share one.
# The shortcut signs in on its first run and saves the session token itself.
# Sign-in needs a 6-digit code, which it prompts for.
BRIGHTWHEEL_EMAIL=
BRIGHTWHEEL_PASSWORD=
BRIGHTWHEEL_CHECKIN_CODE=
BRIGHTWHEEL_SCHOOL_SECRET=
BRIGHTWHEEL_SCHOOL_ID=

# Deliberately fake. The integration suite bakes these into the shortcuts it
# installs on the simulator, and points them at the mock Brightwheel, so none
# of it is ever sent anywhere real. Do not put live credentials here — that is
# what the gitignored .env at the repo root is for.
BRIGHTWHEEL_CHECKIN_CODE=1234
BRIGHTWHEEL_SCHOOL_SECRET=test-school-secret
BRIGHTWHEEL_EMAIL=tester@example.invalid
BRIGHTWHEEL_PASSWORD=not-a-real-password
BRIGHTWHEEL_SCHOOL_ID=33333333-3333-4333-8333-333333333333
